<file path="frontend/src/styles.scss">
/* Import Material theming tools (must be first!) */
@use '@angular/material' as mat;

/* Import Tailwind */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Material base styles */
@include mat.core();

/* --- Palette setup --- */
$my-primary: mat.define-palette(mat.$indigo-palette);
$my-accent:  mat.define-palette(mat.$pink-palette, A200, A100, A400);
$my-warn:    mat.define-palette(mat.$red-palette);

/* --- Light theme --- */
$my-light-theme: mat.define-light-theme((
  color: (
    primary: $my-primary,
    accent:  $my-accent,
    warn:    $my-warn,
  )
));

/* --- Dark theme --- */
$my-dark-theme: mat.define-dark-theme((
  color: (
    primary: $my-primary,
    accent:  $my-accent,
    warn:    $my-warn,
  )
));

/* Default: light theme for all Material components */
@include mat.all-component-themes($my-light-theme);

/* ============================================================
   DARK THEME
   Triggered when <html> has class="dark"
   ============================================================ */
.dark {
  /* Material component dark overrides */
  @include mat.all-component-themes($my-dark-theme);

  /* ---- Base backgrounds & text ---- */
  background-color: #121212;
  color: rgba(255, 255, 255, 0.87);

  body {
    background-color: #121212 !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Material app background ---- */
  .mat-app-background,
  .mat-drawer-container {
    background-color: #1e1e1e !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Sidenav panel ---- */
  .mat-drawer {
    background-color: #1e1e1e !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  .mat-drawer-content {
    background-color: #121212 !important;
  }

  /* ---- Toolbar ---- */
  .mat-toolbar {
    background-color: #1f2937 !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Sidenav inner toolbar (stone-700 override) ---- */
  .sidenav-header-toolbar {
    background-color: #111827 !important;
    color: white !important;
  }

  /* ---- Tables ---- */
  .mat-table {
    background-color: #1e1e1e !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  .mat-header-row,
  .mat-row,
  .mat-footer-row {
    background-color: #1e1e1e !important;
  }

  .mat-header-cell,
  .mat-cell,
  .mat-footer-cell {
    color: rgba(255, 255, 255, 0.87) !important;
    border-bottom-color: rgba(255, 255, 255, 0.12) !important;
  }

  .mat-row:hover {
    background-color: #2d2d2d !important;
  }

  /* ---- Paginator ---- */
  .mat-paginator {
    background-color: #1e1e1e !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  .mat-paginator-page-size-label,
  .mat-paginator-range-label {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  /* ---- Form fields ---- */
  .mat-form-field {
    color: rgba(255, 255, 255, 0.87) !important;
  }

  .mat-form-field-label {
    color: rgba(255, 255, 255, 0.6) !important;
  }

  .mat-input-element,
  .mat-select-value,
  .mat-select-arrow {
    color: rgba(255, 255, 255, 0.87) !important;
  }

  .mat-form-field-underline {
    background-color: rgba(255, 255, 255, 0.42) !important;
  }

  /* ---- Cards ---- */
  .mat-card {
    background-color: #2d2d2d !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Dialogs ---- */
  .mat-dialog-container {
    background-color: #2d2d2d !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Menu / Select panel ---- */
  .mat-menu-panel,
  .mat-select-panel,
  .mat-autocomplete-panel {
    background-color: #2d2d2d !important;
  }

  .mat-option {
    color: rgba(255, 255, 255, 0.87) !important;

    &:hover,
    &.mat-active {
      background-color: rgba(255, 255, 255, 0.08) !important;
    }
  }

  /* ---- Navigation list ---- */
  .mat-list-item,
  .mat-nav-list .mat-list-item {
    color: rgba(255, 255, 255, 0.87) !important;

    &:hover {
      background-color: rgba(255, 255, 255, 0.08) !important;
    }
  }

  /* ---- Dividers ---- */
  .mat-divider {
    border-top-color: rgba(255, 255, 255, 0.12) !important;
  }

  /* ---- Icons ---- */
  .mat-icon {
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Buttons ---- */
  .mat-button,
  .mat-stroked-button {
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Chips ---- */
  .mat-chip {
    background-color: #3d3d3d !important;
    color: rgba(255, 255, 255, 0.87) !important;
  }

  /* ---- Course card custom styles ---- */
  .course-card {
    background-color: #1e2535 !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
    color: rgba(255, 255, 255, 0.87) !important;

    .course-category {
      color: rgba(255, 255, 255, 0.5) !important;
    }
  }

  /* ---- Tailwind override for dark backgrounds ---- */
  .bg-white {
    background-color: #1e1e1e !important;
  }

  .bg-gray-50 {
    background-color: #1a1a1a !important;
  }

  .bg-gray-100 {
    background-color: #232323 !important;
  }

  .text-gray-600,
  .text-gray-700,
  .text-gray-800,
  .text-gray-900 {
    color: rgba(255, 255, 255, 0.7) !important;
  }

  .border-gray-200 {
    border-color: rgba(255, 255, 255, 0.12) !important;
  }
}

/* ============================================================
   GLOBAL BASE
   ============================================================ */
body {
  margin: 0;
  font-family: 'Roboto', 'Helvetica Neue', sans-serif;
  background-color: #ffffff;
  color: #1e293b;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* Smooth theme transitions for key elements */
mat-toolbar,
mat-sidenav,
mat-sidenav-content,
.mat-card,
.mat-table,
.mat-dialog-container {
  transition: background-color 0.2s ease, color 0.2s ease;
}
