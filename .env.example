# JWT (единый секрет для всех сервисов)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRATION=7200
JWT_REFRESH_EXPIRATION=86400

# Telegram Bot (SEC Notify)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# MySQL
MYSQL_ROOT_PASSWORD=root

# SSO
SSO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:4200,http://localhost:4201
SSO_LMS_SECRET=lms-secret-change-in-prod
SSO_CRM_SECRET=crm-secret-change-in-prod
SSO_MOBILE_SECRET=mobile-secret-change-in-prod
SSO_LMS_REDIRECT_URI=http://localhost:4200/auth/sso
SSO_LMS_ORIGIN=http://localhost:4200
SSO_CRM_REDIRECT_URI=http://localhost:4201/sso/callback
SSO_CRM_ORIGIN=http://localhost:4201

CRM_BASE_URL=http://localhost:4201
LMS_BASE_URL=http://localhost:4200

# Audit log (Bundle 1)
# Generate with: openssl rand -hex 32
AUDIT_INTERNAL_TOKEN=change-me-shared-secret-for-internal-audit-calls
AUDIT_RETENTION_DAYS=90

# Branding (Bundle 1, per-customer)
BRAND_NAME=SEC
BRAND_PRODUCT_NAME=SmartEduControl
BRAND_PRIMARY_COLOR=#4f46e5
BRAND_LOGO_URL=/branding/logo.png
BRAND_FAVICON_URL=/branding/favicon.ico
BRAND_SUPPORT_EMAIL=support@sec.kz

# Landing page port (optional)
LANDING_PORT=80
